# ── Backend ───────────────────────────────────────────────────
REACT_APP_BACKEND_URL=http://localhost:8000

# ── RudderStack ───────────────────────────────────────────────
# Copy your Write Key from:
#   RS Dashboard → Sources → HomeCart App → Settings → Write Key
REACT_APP_RUDDER_WRITE_KEY=YOUR_WRITE_KEY_HERE

# Data Plane URL — from your RudderStack workspace
# Example: https://rudderstachcyf.dataplane.rudderstack.com
REACT_APP_RUDDER_DATA_PLANE_URL=https://hosted.rudderlabs.com
